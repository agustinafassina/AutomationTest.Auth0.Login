{
  "name": "auth0-automated-tests",
  "version": "1.0.0",
  "description": "Automated Playwright end-to-end tests for Auth0 login",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "cross-env DEBUG=true playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:update-snapshots": "playwright test --update-snapshots"
  },
  "keywords": [
    "playwright",
    "auth0",
    "e2e",
    "testing"
  ],
  "author": "Agustina Fassina",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10"
  }
}
