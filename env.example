# URL of your application that redirects to Auth0
APP_URL=http://localhost:3000

# Base URL (optional, used as fallback)
BASE_URL=http://localhost:3000

# Auth0 credentials for tests
AUTH0_EMAIL=your-email@example.com
AUTH0_PASSWORD=your-secure-password

# CSS selector of the button you want to click after login
# Examples:
# BUTTON_SELECTOR=button[type="submit"]
# BUTTON_SELECTOR=.my-button
# BUTTON_SELECTOR=#button-id
# BUTTON_SELECTOR=text=Click here
BUTTON_SELECTOR=button[type="submit"]

