# URL of your application that redirects to Auth0
APP_URL=http://localhost:3000

# Base URL (optional, used as fallback)
BASE_URL=http://localhost:3000

# Auth0 credentials for tests
AUTH0_EMAIL=your-email@example.com
AUTH0_PASSWORD=your-secure-password

# CSS selector of the button you want to click after login
# Examples:
# BUTTON_SELECTOR=button[type="submit"]
# BUTTON_SELECTOR=.my-button
# BUTTON_SELECTOR=#button-id
# BUTTON_SELECTOR=text=Click here
BUTTON_SELECTOR=button[type="submit"]


# (Optional) Auth0 domain. Required if you use a custom domain (e.g. login.myapp.com).
# If empty, any *.auth0.com URL is treated as the Auth0 login page.
# AUTH0_DOMAIN=dev-xxxxxx.us.auth0.com

# (Optional) Selector that must be visible after clicking BUTTON_SELECTOR.
# Used to assert that the post-login action actually worked.
# SUCCESS_SELECTOR=text=Welcome
